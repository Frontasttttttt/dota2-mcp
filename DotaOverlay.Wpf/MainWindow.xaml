<Window x:Class="DotaOverlay.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dota 2 Timers HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="1560" Top="40" Width="980" Height="65"
        Focusable="False">
    <Window.Resources>
        <Style x:Key="GlassBorder" TargetType="Border">
            <Setter Property="Background" Value="#E60D1117" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.8" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimerItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="BorderBrush" Value="#21262D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource GlassBorder}" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Статус матча / Время -->
            <Border Style="{StaticResource TimerItemStyle}" Background="#0D1117">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏱️" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtClock" Text="00:00" Foreground="#E6EDF3" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Река (Вода / Активные руны) -->
            <Border x:Name="BoxRiver" Style="{StaticResource TimerItemStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IconRiver" Text="💧" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtRiverTitle" Text="РЕКА" Foreground="#8B949E" FontSize="8" FontWeight="Bold" />
                        <TextBlock x:Name="TxtRiverFmt" Text="02:00" Foreground="#58A6FF" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Лотусы -->
            <Border x:Name="BoxLotus" Style="{StaticResource TimerItemStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🌸" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ЛОТУС" Foreground="#8B949E" FontSize="8" FontWeight="Bold" />
                        <TextBlock x:Name="TxtLotusFmt" Text="03:00" Foreground="#F43F5E" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Баунти руны -->
            <Border x:Name="BoxBounty" Style="{StaticResource TimerItemStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💰" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="БАУНТИ" Foreground="#8B949E" FontSize="8" FontWeight="Bold" />
                        <TextBlock x:Name="TxtBountyFmt" Text="04:00" Foreground="#FBBF24" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Руна мудрости -->
            <Border x:Name="BoxWisdom" Style="{StaticResource TimerItemStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📖" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="МУДРОСТЬ" Foreground="#8B949E" FontSize="8" FontWeight="Bold" />
                        <TextBlock x:Name="TxtWisdomFmt" Text="07:00" Foreground="#A78BFA" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Рошан и День/Ночь -->
            <Border x:Name="BoxRoshan" Style="{StaticResource TimerItemStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IconRoshan" Text="☀️" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtRoshanTitle" Text="РОШАН: ЮГ" Foreground="#8B949E" FontSize="8" FontWeight="Bold" />
                        <TextBlock x:Name="TxtRoshanFmt" Text="05:00" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Терзатель -->
            <Border x:Name="BoxTormentor" Style="{StaticResource TimerItemStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛡️" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ТЕРЗАТЕЛЬ" Foreground="#8B949E" FontSize="8" FontWeight="Bold" />
                        <TextBlock x:Name="TxtTormentorFmt" Text="20:00" Foreground="#34D399" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Нейтральные предметы (Т1..Т5) -->
            <Border x:Name="BoxNeutrals" Style="{StaticResource TimerItemStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNeutralsTitle" Text="НЕЙТРАЛКИ Т1" Foreground="#8B949E" FontSize="8" FontWeight="Bold" />
                        <TextBlock x:Name="TxtNeutralsFmt" Text="07:00" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Стак леса (:53) -->
            <Border x:Name="BoxStack" Style="{StaticResource TimerItemStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IconStack" Text="🌲" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStackTitle" Text="СТАК ЛЕСА" Foreground="#8B949E" FontSize="8" FontWeight="Bold" />
                        <TextBlock x:Name="TxtStackFmt" Text="53с" Foreground="#E6EDF3" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Байбек -->
            <Border x:Name="BoxBuyback" Style="{StaticResource TimerItemStyle}" Background="#0F1F17" BorderBrush="#10B981">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💵" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="БАЙБЕК" Foreground="#8B949E" FontSize="8" FontWeight="Bold" />
                        <TextBlock x:Name="TxtBuybackStatus" Text="ГОТОВ" Foreground="#10B981" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
